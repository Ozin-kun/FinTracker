generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
    url      = env("DATABASE_URL")
}

model Transaction {
    id          Int      @id @default(autoincrement())
    type        String
    category    String
    amount      Int
    description String
    date        DateTime @default(now())
    createdAt   DateTime @default(now())
}
